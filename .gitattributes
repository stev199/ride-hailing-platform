# Normalize all text files to LF for consistent CI behavior
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Signing material and build outputs are binary (and must never be committed anyway)
*.jks binary
*.keystore binary
*.p12 binary
*.pk8 binary
*.apk binary
*.aab binary
